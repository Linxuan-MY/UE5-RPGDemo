[Unit]
Description=RPGDemo Unreal Dedicated Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rpgdemo
Group=rpgdemo
WorkingDirectory=/opt/rpgdemo/current
ExecStart=/bin/sh /opt/rpgdemo/current/RPGDemoServer.sh MultiplayerLobbyMap?game=/Script/RPGDemo.RPGDemoLobbyGameMode -server -log -port=7777
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
